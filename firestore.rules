rules_version = '2';

// Reglas de seguridad de Firestore para Active Maths Championship.
//
// CÓMO APLICARLAS:
//   Firebase Console -> Firestore Database -> Reglas -> pegar este archivo -> Publicar
//   (o, si más adelante configurás Firebase CLI: `firebase deploy --only firestore:rules`)
//
// IMPORTANTE: la lista ADMIN_EMAILS de abajo debe coincidir siempre con
// ALLOWED_EMAILS en admin.html. Si agregás un nuevo docente/admin, actualizá los dos lugares.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in [
               'joaquin.alva@activelearning.com.ar',
               'colaboradores.aprendizajes@activelearning.com.ar'
             ];
    }

    function isOwn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isActiveCompetition(competitionId) {
      let settings = get(/databases/$(database)/documents/config/settings).data;
      return settings.activeCompetitionId == competitionId;
    }

    function isActiveOpenCompetition(competitionId) {
      let settings = get(/databases/$(database)/documents/config/settings).data;
      return isActiveCompetition(competitionId) &&
             settings.competitionStatuses[competitionId] == 'open';
    }

    // Perfil del estudiante. Puede actualizarse solo si el estudiante aún no
    // inició el examen (no existe exam_state); una vez que el examen está en
    // curso o enviado, solo el admin puede modificar el perfil.
    match /users/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin() ||
                       (request.auth != null && request.auth.uid == uid &&
                        !exists(/databases/$(database)/documents/exam_states/$(uid)));
      allow delete: if isAdmin();
    }

    // Estado en progreso del examen. El estudiante puede crear y actualizar
    // su propio estado. La única restricción: no puede "des-terminar" un examen
    // (pasar finished=true a false), solo el admin puede hacer eso.
    match /exam_states/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin() ||
                       (request.auth != null && request.auth.uid == uid &&
                        (resource.data.get('finished', false) != true ||
                         request.resource.data.get('finished', false) == true));
      allow delete: if isAdmin();
    }

    // Entrega final. El estudiante puede crear y actualizar su propia entrega
    // (permite reintentos si la red falla durante el envío). Solo el admin
    // puede borrarla o marcar clasificado.
    match /submissions/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin() ||
                       (isOwn(uid) &&
                        request.resource.data.get('classified', false) == resource.data.get('classified', false) &&
                        request.resource.data.get('classifiedAt', null) == resource.data.get('classifiedAt', null));
      allow delete: if isAdmin();
    }

    // Datos de las tomas nuevas. Cada competencia tiene documentos propios;
    // esto impide mezclar perfiles, estados, entregas y clasificaciones.
    match /competition_users/{competitionId}/users/{uid} {
      allow read: if isOwn(uid) || isAdmin();
      allow create, update: if isOwn(uid) && isActiveOpenCompetition(competitionId);
      allow delete: if isAdmin();
    }

    match /competition_exam_states/{competitionId}/states/{uid} {
      allow read: if isOwn(uid) || isAdmin();
      allow create: if isOwn(uid) && isActiveOpenCompetition(competitionId);
      allow update: if isAdmin() ||
                       (isOwn(uid) && isActiveCompetition(competitionId) &&
                        (resource.data.get('finished', false) != true ||
                         request.resource.data.get('finished', false) == true));
      allow delete: if isAdmin();
    }

    match /competition_submissions/{competitionId}/entries/{uid} {
      allow read: if isOwn(uid) || isAdmin();
      allow create: if isOwn(uid) && isActiveCompetition(competitionId) &&
                       existsAfter(/databases/$(database)/documents/competition_exam_states/$(competitionId)/states/$(uid));
      allow update, delete: if isAdmin();
    }

    match /competition_classifications/{competitionId}/entries/{uid} {
      allow read: if isOwn(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Enunciados (sin respuesta correcta): cualquier usuario autenticado los
    // puede leer durante el examen; solo el admin los edita.
    match /questions/{category} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Clave de respuestas: SOLO el admin puede leerla o escribirla. Los
    // estudiantes nunca deben poder acceder a esta colección — así, aunque
    // abran las herramientas de desarrollador, no pueden ver la respuesta
    // correcta antes de responder.
    match /answer_keys/{category} {
      allow read, write: if isAdmin();
    }

    // Enunciados y claves de las tomas nuevas se aíslan por competencia. Los
    // estudiantes solo pueden leer enunciados de la instancia pública abierta.
    match /competition_questions/{competitionId}/categories/{category} {
      allow read: if isAdmin() ||
                     (request.auth != null && isActiveOpenCompetition(competitionId));
      allow write: if isAdmin();
    }

    match /competition_answer_keys/{competitionId}/categories/{category} {
      allow read, write: if isAdmin();
    }

    // Configuración general (duración del examen, etc.)
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
